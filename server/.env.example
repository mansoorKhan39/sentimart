NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/sentimart_dev
MONGODB_MAX_POOL=5
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=1
JWT_ACCESS_SECRET=change-me-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
RESET_TOKEN_TTL_MIN=15
BCRYPT_COST=12
RATE_LIMIT_GENERAL_PER_MIN=100
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MIN=15
# Email: brevo or resend (free tiers). Leave EMAIL_PROVIDER=none to only log emails.
EMAIL_PROVIDER=none
EMAIL_API_KEY=
MAIL_FROM=SentiMart <no-reply@example.com>
# Cloudinary (product images): cloudinary.com -> Dashboard. Leave empty to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# NLP service (Module 4). Leave NLP_URL empty to skip analysis (reviews stay "pending").
NLP_URL=http://localhost:8000
NLP_API_KEY=change-me-long-random
NLP_TIMEOUT_MS=3000
SPAM_THRESHOLD=0.7
REVIEW_EDIT_DAYS=7
# Protects /api/v1/internal/retry-pending. Vercel cron sends it automatically as a Bearer token.
CRON_SECRET=change-me-long-random
# Seller dashboard: products with stock at or below this are flagged as low stock
LOW_STOCK_THRESHOLD=5
# only for: npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
